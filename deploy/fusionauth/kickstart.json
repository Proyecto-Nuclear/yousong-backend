{
  "variables": {
    "apiKey": "#{ENV.FUSIONAUTH_API_KEY}",
    "clientSecret": "#{ENV.FUSIONAUTH_CLIENT_SECRET}",
    "consoleAdminEmail": "#{ENV.FUSIONAUTH_ADMIN_EMAIL}",
    "consoleAdminPassword": "#{ENV.FUSIONAUTH_ADMIN_PASSWORD}",
    "ownerEmail": "#{ENV.OWNER_EMAIL}",
    "ownerPassword": "#{ENV.OWNER_PASSWORD}",
    "asymmetricKeyId": "#{UUID()}",
    "applicationId": "c2f6a1b4-3d5e-4f70-8a9b-6e1d2c3b4a59",
    "consoleAdminUserId": "00000000-0000-4000-8000-0000000000a0",
    "ownerUserId": "00000000-0000-4000-8000-0000000000b1",
    "issuer": "http://127.0.0.1:9011"
  },
  "apiKeys": [
    {
      "key": "#{apiKey}",
      "description": "YouSong deployment key (generated in deploy/config.env): demo data command only."
    }
  ],
  "requests": [
    {
      "method": "PATCH",
      "url": "/api/tenant/#{FUSIONAUTH_TENANT_ID}",
      "body": {
        "tenant": {
          "issuer": "#{issuer}"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/key/generate/#{asymmetricKeyId}",
      "body": {
        "key": {
          "algorithm": "RS256",
          "name": "Yousong access token signing key (RS256)",
          "length": 2048
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/application/#{applicationId}",
      "body": {
        "application": {
          "name": "Yousong",
          "oauthConfiguration": {
            "clientId": "#{applicationId}",
            "clientSecret": "#{clientSecret}",
            "authorizedRedirectURLs": [
              "http://localhost:3000/api/auth/callback/fusionauth",
              "http://localhost:3000/"
            ],
            "logoutURL": "http://localhost:3000/",
            "enabledGrants": [
              "authorization_code",
              "refresh_token"
            ],
            "generateRefreshTokens": true,
            "requireRegistration": true
          },
          "registrationConfiguration": {
            "enabled": true,
            "type": "basic",
            "loginIdType": "email",
            "confirmPassword": true
          },
          "jwtConfiguration": {
            "enabled": true,
            "accessTokenKeyId": "#{asymmetricKeyId}",
            "idTokenKeyId": "#{asymmetricKeyId}",
            "timeToLiveInSeconds": 900,
            "refreshTokenTimeToLiveInMinutes": 10080
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{consoleAdminUserId}",
      "body": {
        "skipRegistrationVerification": true,
        "user": {
          "email": "#{consoleAdminEmail}",
          "password": "#{consoleAdminPassword}",
          "firstName": "FusionAuth",
          "lastName": "Console"
        },
        "registration": {
          "applicationId": "#{FUSIONAUTH_APPLICATION_ID}",
          "roles": [
            "admin"
          ]
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{ownerUserId}",
      "body": {
        "skipRegistrationVerification": true,
        "user": {
          "email": "#{ownerEmail}",
          "password": "#{ownerPassword}",
          "firstName": "Propietario",
          "lastName": "YouSong"
        },
        "registration": {
          "applicationId": "#{applicationId}"
        }
      }
    }
  ]
}
