# Configuración del despliegue de YouSong (copia de config.env.example).
# deploy.sh / deploy.ps1 crea config.env la primera vez y llena lo que esté vacío. Nunca subas config.env a git.

# IP de este PC en la red wifi/LAN (los celulares se conectan a ella). El script la detecta y la propone.
# Si cambias de red, vuelve a ejecutar el script: detecta la IP nueva y reconstruye la APK.
HOST_IP=

# Clave de YouTube Data API v3 (Google Cloud Console). Sin ella no hay búsqueda de canciones ni datos demo.
YOUTUBE_API_KEY=

# Puerto de la página de descarga de la APK (el de la API para los celulares es siempre 8080).
DOWNLOAD_PORT=8000

# Cuentas
OWNER_EMAIL=propietario@yousong.local
DEMO_OWNER_EMAIL=demo@yousong.local
FUSIONAUTH_ADMIN_EMAIL=admin@yousong.local

# Secretos: vacíos = el script genera valores aleatorios una sola vez y no los vuelve a cambiar.
# Se aplican al crear las bases de datos y FusionAuth: cambiarlos después exige "reset" (borra los datos).
# ANALYTICS_HMAC_KEY nunca debe cambiar mientras existan datos: una clave nueva duplica la analítica.
POSTGRES_PASSWORD=
FUSIONAUTH_DB_ROOT_PASSWORD=
FUSIONAUTH_DB_PASSWORD=
FUSIONAUTH_API_KEY=
FUSIONAUTH_CLIENT_SECRET=
FUSIONAUTH_ADMIN_PASSWORD=
OWNER_PASSWORD=
DEMO_OWNER_PASSWORD=
AUTH_SECRET=
ANALYTICS_HMAC_KEY=
